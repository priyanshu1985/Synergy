rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Requests collection security rules
    match /requests/{requestId} {
      // Anyone (anonymous citizens) can submit SOS distress calls
      allow create: if true;
      
      // Anyone can read requests to track their live rescue status
      allow read: if true;
      
      // Authenticated responders (command center & rescue teams) can perform updates.
      // Unauthenticated citizens can update to mark themselves safe (status set to 'rescued').
      allow update: if request.auth != null || request.resource.data.status == 'rescued';
    }

    // Hospital collection security rules
    match /hospitals/{hospitalId} {
      allow read, write: if request.auth != null;
    }

    // Shelter collection security rules
    match /shelters/{shelterId} {
      allow read, write: if request.auth != null;
    }

    // Resource collection security rules
    match /resources/{resourceId} {
      allow read, write: if request.auth != null;
    }

    // Predictive Flood Warning security rules
    match /flood_warnings/{warningId} {
      // Anyone (unauthenticated citizens) can read flood warnings for early warnings
      allow read: if true;
      
      // Responders and admin Cloud Functions can write/update flood warnings
      allow write: if request.auth != null;
    }

  }
}
