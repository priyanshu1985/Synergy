rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Requests collection security rules
    match /requests/{requestId} {
      // Anyone (anonymous citizens) can submit SOS distress calls
      allow create: if true;
      
      // Responders must be authenticated to read or update requests
      allow read: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Hospital collection security rules
    match /hospitals/{hospitalId} {
      allow read, write: if request.auth != null;
    }

    // Shelter collection security rules
    match /shelters/{shelterId} {
      allow read, write: if request.auth != null;
    }

    // Resource collection security rules
    match /resources/{resourceId} {
      allow read, write: if request.auth != null;
    }

  }
}
